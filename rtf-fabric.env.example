# Auto-generated by 07-register-fabric.sh - do not edit by hand.
# Sourced automatically by 08-install-rtf.sh, 09-setup-ingress-template.sh,
# and 10-apply-ingress-template.sh if present.
#
# This .example file is a placeholder showing the shape of the real
# rtf-fabric.env that 07-register-fabric.sh writes for you. You do NOT
# create this by hand - run 07-register-fabric.sh and it will be generated
# with your real values. The real rtf-fabric.env is git-ignored because it
# contains live registry credentials and activation data.

# Runtime Fabric ID returned by the Anypoint API when the fabric is created.
FABRIC_ID="<generated-fabric-id>"

# Base64 activation data for this fabric registration (scoped to ONE fabric).
ACTIVATION_DATA="<generated-activation-data>"

# Registry credentials for pulling RTF container images.
REGISTRY_USER="<generated-registry-user>"
REGISTRY_PASS="<generated-registry-password>"

# MuleSoft RTF image registry host.
RTF_REGISTRY="rtf-runtime-registry.kprod.msap.io"

# Domain carried over from rtf-config.env.
DOMAIN="<your-subdomain.your-domain.com>"
