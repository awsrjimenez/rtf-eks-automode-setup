# Copy this file to rtf-config.env and fill in the real values.
# rtf-config.env is loaded automatically by 07-register-fabric.sh if
# present - fill this in once, and you won't need to edit any script
# directly, even across re-downloads of this runbook.
#
# rtf-config.env is your personal/org credentials - do not commit it to
# version control or share it. This example file (rtf-config.env.example)
# is safe to share/commit since it contains no real values.

# Your Anypoint organization ID.
# Access Management -> your org -> the ID shown in the URL or org details.
ORG_ID="<your-anypoint-organization-id>"

# A Connected App with Runtime Fabric management scope.
# Access Management -> Connected Apps -> Create App ->
# "App acts on its own behalf (client credentials)" -> grant Runtime
# Manager / Runtime Fabric scopes.
CLIENT_ID="<connected-app-client-id>"
CLIENT_SECRET="<connected-app-client-secret>"

# Name and AWS region for the Runtime Fabric to register.
FABRIC_NAME="rtf-automode-poc"
REGION="us-east-1"

# Environment to associate the fabric with, resolved by name via the
# Environments API. Must match the name exactly as it appears in
# Anypoint (case-sensitive). Common values: "Sandbox", "Design",
# "Production".
ENVIRONMENT_NAME="Sandbox"

# Leave blank to resolve ENVIRONMENT_NAME automatically (recommended).
# Set this directly instead (a UUID, not a name) to skip the name lookup
# entirely - useful if you already know the ID or the name lookup isn't
# working for some reason.
ENVIRONMENT_ID=""

# A domain (or subdomain) you own and can add DNS records for. Not
# fetched from any API - you provide this. Passed through into
# rtf-fabric.env by 07-register-fabric.sh so 09-setup-ingress-template.sh
# can pick it up automatically too, the same way 08-install-rtf.sh already
# picks up ACTIVATION_DATA/REGISTRY_USER/REGISTRY_PASS/RTF_REGISTRY.
# A subdomain (e.g. "rtf.yourcompany.com") is recommended over a bare
# root domain if that domain is shared with other services - see lesson 9
# in README.md for why. Example used throughout this runbook's
# documentation: rtf.mulesoftdemo.com
DOMAIN="<your-subdomain.your-domain.com>"
